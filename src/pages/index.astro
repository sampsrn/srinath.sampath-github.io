---
import Base from '../layouts/Base.astro';
import { profile, asset } from '../config';
import experience from '../data/experience.json';
import interests from '../data/interests.json';
import hobbies from '../data/hobbies.json';
import { posts } from '../data/linkedin';

const { links } = profile;

// Build the conditional links nav — empty strings are hidden (PRD §6 / R1).
const nav = [
  links.linkedin && { label: 'LinkedIn', href: links.linkedin },
  links.github && { label: 'GitHub', href: links.github },
  links.email && { label: 'Email', href: `mailto:${links.email}` },
].filter(Boolean) as { label: string; href: string }[];

const year = new Date().getFullYear();
---

<Base>
  <main class="mx-auto max-w-prose px-5 py-16 sm:px-6 sm:py-24">
    <!-- 1. Hero -->
    <header class="flex flex-col-reverse items-start gap-6 sm:flex-row sm:items-center sm:gap-8">
      <div class="flex-1">
        <h1 class="font-display text-4xl font-semibold leading-tight tracking-tight sm:text-5xl">
          {profile.name}
        </h1>
        <p class="mt-3 font-mono text-sm text-accent sm:text-base">{profile.tagline}</p>
        <p class="mt-2 text-sm text-slate">{profile.location}</p>
      </div>
      <img
        src={asset(profile.photo)}
        alt={`Portrait of ${profile.name}`}
        width="112"
        height="112"
        class="h-24 w-24 shrink-0 rounded-full border border-black/5 object-cover shadow-sm sm:h-28 sm:w-28"
      />
    </header>

    <!-- 2. Description -->
    <section class="mt-10" aria-label="About">
      <p class="text-base leading-relaxed text-ink/90 sm:text-lg">{profile.description}</p>
    </section>

    <!-- 3. Links nav (conditional) -->
    {
      nav.length > 0 && (
        <nav class="mt-8 flex flex-wrap gap-3" aria-label="Profile links">
          {nav.map((item) => (
            <a
              href={item.href}
              class="rounded-full border border-accent/30 bg-accent-soft px-4 py-1.5 text-sm font-medium text-accent transition-colors hover:bg-accent hover:text-paper"
            >
              {item.label}
            </a>
          ))}
        </nav>
      )
    }

    <!-- 4. Experience -->
    <section class="mt-16" aria-labelledby="experience-heading">
      <h2 id="experience-heading" class="font-display text-2xl font-semibold tracking-tight">
        Experience
      </h2>
      <ol class="mt-6 space-y-8 border-l border-black/10 pl-6">
        {
          experience.map((job) => (
            <li class="relative">
              <span class="absolute -left-[27px] top-1.5 h-2.5 w-2.5 rounded-full bg-accent ring-4 ring-paper" aria-hidden="true" />
              <div class="flex flex-wrap items-baseline justify-between gap-x-3">
                <h3 class="text-lg font-semibold">{job.role}</h3>
                <span class="font-mono text-xs text-slate">{job.period}</span>
              </div>
              <p class="text-sm font-medium text-accent">{job.company}</p>
              <p class="mt-2 text-sm leading-relaxed text-ink/85">{job.summary}</p>
              <ul class="mt-3 flex flex-wrap gap-1.5">
                {job.tags.map((tag) => (
                  <li class="rounded bg-black/[0.04] px-2 py-0.5 font-mono text-[11px] text-slate">
                    {tag}
                  </li>
                ))}
              </ul>
            </li>
          ))
        }
      </ol>
    </section>

    <!-- 5. Interests -->
    <section class="mt-16" aria-labelledby="interests-heading">
      <h2 id="interests-heading" class="font-display text-2xl font-semibold tracking-tight">
        Tech Interests
      </h2>
      <div class="mt-6 grid gap-4 sm:grid-cols-2">
        {
          interests.map((item) => (
            <div class="rounded-lg border border-black/5 bg-white/50 p-4">
              <h3 class="text-sm font-semibold text-ink">{item.name}</h3>
              <p class="mt-1 text-sm leading-relaxed text-slate">{item.note}</p>
            </div>
          ))
        }
      </div>
    </section>

    <!-- 6. LinkedIn -->
    <section class="mt-16" aria-labelledby="linkedin-heading">
      <h2 id="linkedin-heading" class="font-display text-2xl font-semibold tracking-tight">
        From LinkedIn
      </h2>
      <div class="mt-6 space-y-4">
        {
          posts.map((post) => (
            <article class="rounded-lg border border-black/5 bg-white/50 p-4">
              <div class="flex flex-wrap items-center justify-between gap-2">
                <div class="flex items-center gap-2">
                  <span
                    class={`rounded-full px-2 py-0.5 text-[11px] font-semibold uppercase tracking-wide ${
                      post.type === 'mine'
                        ? 'bg-accent text-paper'
                        : 'bg-black/[0.06] text-slate'
                    }`}
                  >
                    {post.type === 'mine' ? 'My post' : 'Shared'}
                  </span>
                  <span class="text-sm font-medium text-ink">{post.author}</span>
                </div>
                <span class="font-mono text-xs text-slate">{post.date}</span>
              </div>
              {post.embed ? (
                <iframe
                  src={post.embed}
                  title={`LinkedIn post by ${post.author}`}
                  class="mt-3 aspect-square w-full rounded border border-black/5"
                  loading="lazy"
                  frameborder="0"
                  allowfullscreen
                />
              ) : (
                <p class="mt-2 text-sm leading-relaxed text-ink/85">{post.blurb}</p>
              )}
              <a
                href={post.url}
                class="mt-3 inline-block text-sm font-medium text-accent underline-offset-2 hover:underline"
                target="_blank"
                rel="noopener noreferrer"
              >
                View on LinkedIn →
              </a>
            </article>
          ))
        }
      </div>
    </section>

    <!-- 7. Hobbies -->
    <section class="mt-16" aria-labelledby="hobbies-heading">
      <h2 id="hobbies-heading" class="font-display text-2xl font-semibold tracking-tight">
        Beyond Work
      </h2>
      <div class="mt-6 grid gap-4 sm:grid-cols-2">
        {
          hobbies.map((item) => (
            <div class="rounded-lg border border-black/5 bg-white/50 p-4">
              <h3 class="text-sm font-semibold text-ink">{item.name}</h3>
              <p class="mt-1 text-sm leading-relaxed text-slate">{item.note}</p>
            </div>
          ))
        }
      </div>
    </section>

    <!-- 8. Footer -->
    <footer class="mt-20 border-t border-black/10 pt-6 text-sm text-slate">
      <p>© {year} {profile.name}. Built with Astro &amp; Tailwind.</p>
    </footer>
  </main>
</Base>
